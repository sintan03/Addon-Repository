{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "sineboss:whitehole",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/sineboss_dot"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 10000,
				"max_particles": 2000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [
					0,
					0,
					0
				],
				"radius": 0,
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"(20 * math.pow(1 - v.particle_age / v.particle_lifetime, 1.3)) * math.cos(v.particle_random_1 * 360 - v.particle_age * 40) * (v.particle_random_2 / 2 + 0.5)",
					"((v.particle_random_4 - 0.5) * 2) * (1 - v.particle_age / v.particle_lifetime)",
					"(20 * math.pow(1 - v.particle_age / v.particle_lifetime, 1.3)) * math.sin(v.particle_random_1 * 360 - v.particle_age * 40) * (v.particle_random_2 / 2 + 0.5)"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_speed": "math.random(0.1,30.0)",
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.05 + 0.05 * (v.particle_age / v.particle_lifetime)",
					"0.05 + 0.05 * (v.particle_age / v.particle_lifetime)"
				],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						0,
						0
					],
					"uv_size": [
						16,
						16
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.8": "#88FFFFFF",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}