{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "sineboss:blackhole2",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/sineboss_dot"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 1000,
				"max_particles": 5000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 8
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [
					0,
					0,
					0
				],
				"radius": 25,
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"((2 * (v.particle_age / v.particle_lifetime)) * v.particle_random_1 * math.cos(v.particle_random_2 * 360))",
					"((20 * (v.particle_age / v.particle_lifetime)) * (math.floor(v.particle_random_3 * 2) * 2 - 1) * (v.particle_random_4 / 4 + 0.75))",
					"((2 * (v.particle_age / v.particle_lifetime)) * v.particle_random_1 * math.sin(v.particle_random_2 * 360))"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.4
			},
			"minecraft:particle_initial_speed": "math.random(12,15)",
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.15 + 0.05 * (v.particle_age / v.particle_lifetime)",
					"0.15 + 0.05 * (v.particle_age / v.particle_lifetime)"
				],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						0,
						0
					],
					"uv_size": [
						16,
						16
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.9": "#88FFFFFF",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}