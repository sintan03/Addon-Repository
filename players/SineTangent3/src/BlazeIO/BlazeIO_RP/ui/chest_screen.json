{
  "namespace": "chest",
  "chest_label": {
    "$display_title|default": "$container_title",
    "text": "$display_title"
  },
  "small_chest_screen": {
    "$display_title|default": "$container_title",
    "$container_size|default": 27,
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "($display_title = 'blazeio:fuel_generator_tier1')",
          "$screen_content": "fuel_generator_tier1.ui_root",
          "$screen_bg_content": "common.screen_background",
          "$display_title": "ui.blazeio:fuel_generator_tier1.title",
          "$container_size": 6
        }
      },
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "($display_title = 'blazeio:macerator_tier1')",
          "$screen_content": "macerator_tier1.ui_root",
          "$screen_bg_content": "common.screen_background",
          "$display_title": "ui.blazeio:macerator_tier1.title",
          "$container_size": 7
        }
      }
    ]
  }
}